# Variables de entorno — plantilla
# Copia este archivo como .env.local y rellena los valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Gmail para enviar emails (contraseña de aplicación de 16 letras, sin espacios)
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=aqui_pon_la_contraseña_de_aplicacion

# Opcional: buzón que recibe el formulario de contacto y los avisos de tests (por defecto GMAIL_USER)
CONTACT_EMAIL=

# Opcional: URL pública del sitio (SEO, sitemap, enlaces de emails). En Vercel se detecta sola (dominio de producción o de la preview).
NEXT_PUBLIC_SITE_URL=
